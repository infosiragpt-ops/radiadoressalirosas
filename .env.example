NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Complete estos valores. No use secretos de ejemplo en producción.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
# Use la cuenta propietaria del esquema. En desarrollo puede coincidir con
# DATABASE_URL; en producción debe estar separada de la cuenta limitada de API.
MIGRATOR_DATABASE_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Genere al menos 32 bytes aleatorios, por ejemplo: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=rs_session
COOKIE_DOMAIN=

# Orígenes separados por coma. No use "*" con cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=120
SHIPPING_FEE_CENTS=0
TRUST_PROXY=false

# Opcionales; solo para el seed inicial y nunca para el runtime.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
CATALOG_PATH=
